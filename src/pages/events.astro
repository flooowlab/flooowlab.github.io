---
import Base from '../layouts/Base.astro';
import { events } from '../data/events';
---
<Base title="Events" description="Events and activities at Flooowlab.">
  <h1>Events</h1>
  <p class="lede">Community making around computation and interaction.</p>

  {events.map((e) => (
    <article>
      <h3>{e.href ? <a href={e.href}>{e.title}</a> : e.title}</h3>
      <p class="meta">{e.status}{e.event && ` · ${e.event.join(', ')}`}</p>
      <p>{e.summary}</p>
    </article>
  ))}
</Base>
