---
import Base from '../layouts/Base.astro';
import FlowBackground from '../components/FlowBackground.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { tools } from '../data/tools';
---
<Base>
  <FlowBackground />
  <!-- <h1>{site.name}</h1> -->
  <p class="lede">{site.tagline}</p>

  <div id="intro">
    <p>
      Flooowlab a design through practice laboratory of the Visual Communication Design Department that promotes computational media and physical computing as a daily design activity. 
      <br /><br />
      Current projects regard the representation of cultural and archaeological heritage through interactive exhibitions and the experimentation with interaction ecologies; past work includes developing AI for wearables and archival interfaces. 
      <br /><br />
      The lab offers a variety of devices and microcontrollers for the design and development of custom electronic devices as well as interactive installations.
  </p>

  <h2>Projects</h2>
  {projects.map((p) => (
    <article>
      <h3>{p.title}</h3>
      <p class="meta">{p.status}</p>
      <p>{p.summary}</p>
    </article>
  ))}
  <p><a href="/projects/">All project details</a></p>

  <h2>Tools</h2>
  <p>
    Experimental tools and software we use to run the lab itself. Currently: {tools.map((t) => t.name).join(', ')}.
    <a href="/tools/">See the tools</a>.
  </p>

  <h2>Events</h2>
  <p>
    We are organizing <strong>Processing Community Day</strong> in İzmir the 26th of October.
    <a href="/events/">Read more</a>.
  </p>

  <div class="affiliations">
    <img src="/ffad_w.svg" alt="Faculty of Fine Arts and Design" />
    <img src="/ieu_w.svg" alt="İzmir University of Economics" />
  </div></div>
</Base>
