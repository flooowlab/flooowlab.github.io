---
import Base from '../layouts/Base.astro';
import FlowBackground from '../components/FlowBackground.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { tools } from '../data/tools';
---
<Base>
  <FlowBackground />
  <!-- <h1>{site.name}</h1> -->
  <p class="lede">{site.tagline}</p>

  <div id="intro">
    <p>
      We are a research lab for computational and interactive digital design, based in İzmir,
      Turkey. We build interactive systems for education and cultural heritage, and we are
      setting up the facility in İzmir to host that work.
    </p>
  <p>
    Flooowlab is a lab for computational and interactive digital design. We build interactive
    systems for education and cultural heritage, and we are setting up the facility in İzmir
    to host that work.
  </p>

  <h2>Projects</h2>
  {projects.map((p) => (
    <article>
      <h3>{p.title}</h3>
      <p class="meta">{p.status}</p>
      <p>{p.summary}</p>
    </article>
  ))}
  <p><a href="/projects/">All project details</a></p>

  <h2>Tools</h2>
  <p>
    Experimental tools and software we use to run the lab itself. Currently: {tools.map((t) => t.name).join(', ')}.
    <a href="/tools/">See the tools</a>.
  </p>

  <h2>Events</h2>
  <p>
    We are organizing <strong>Processing Community Day</strong> in İzmir the 26th of October.
    <a href="/events/">Read more</a>.
  </p>

  <div class="affiliations">
    <img src="/ffad_w.svg" alt="Faculty of Fine Arts and Design" />
    <img src="/ieu_w.svg" alt="İzmir University of Economics" />
  </div></div>
</Base>
